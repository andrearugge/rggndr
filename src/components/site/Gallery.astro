---
// Layout identico alla gallery attuale: contatore + titolo a sinistra, foto grande a destra,
// miniature numerate in basso. Tutto il contenuto è nell'HTML (indicizzabile, leggibile senza JS).
import type { GalleryItem } from '../../data/gallery';

interface Props {
  items: GalleryItem[];
}
const { items } = Astro.props;
const pad = (n: number) => String(n).padStart(2, '0');
---
<section
  data-gallery
  data-index="0"
  aria-roledescription="carousel"
  aria-label="Gallery"
  class="container-site h-[calc(100dvh-52px)] overflow-hidden pt-4 pb-4 lg:h-[calc(100dvh-100px)] lg:pt-0 lg:pb-6"
>
  <div class="flex h-full flex-col justify-between gap-[5%]">
    <div class="flex h-[70%] flex-col gap-4 lg:flex-row">
      <div class="flex flex-row items-start gap-2 lg:w-1/2 lg:flex-col lg:items-start lg:justify-end">
        <p data-gallery-counter class="leading-[.85]" aria-live="polite">
          <span class="relative inline-flex overflow-hidden align-bottom"><span data-gallery-index>1</span></span> / {items.length}
        </p>
        <div data-gallery-titles class="grid overflow-hidden">
          {items.map((item, i) => (
            <h2
              data-gallery-title
              data-active={i === 0 ? '' : undefined}
              class="col-start-1 row-start-1 self-end text-[16px] leading-[.85] uppercase lg:font-compact lg:text-[102px] lg:font-black 2xl:text-[120px]"
            >
              {item.title}
            </h2>
          ))}
        </div>
      </div>
      <div data-gallery-stage class="relative max-h-[calc(100%-30px)] flex-1 touch-pan-y select-none lg:max-h-full lg:w-1/2">
        {items.map((item, i) => (
          <figure data-gallery-slide data-active={i === 0 ? '' : undefined} class="absolute inset-0 flex items-start justify-start lg:items-end lg:justify-end">
            <img
              src={item.src}
              alt={item.title}
              width={item.width}
              height={item.height}
              loading={i === 0 ? 'eager' : 'lazy'}
              decoding="async"
              draggable="false"
              class="block h-full w-auto max-w-full object-contain object-left-top lg:object-right-bottom"
            />
          </figure>
        ))}
      </div>
    </div>
    <div data-gallery-thumbs class="no-scrollbar h-[25%] overflow-x-auto overflow-y-hidden">
      <ol class="flex h-full gap-2">
        {items.map((item, i) => (
          <li class="h-full shrink-0">
            <button
              type="button"
              data-gallery-thumb
              aria-current={i === 0 ? 'true' : 'false'}
              aria-label={`Mostra ${item.title}`}
              class="group flex h-full flex-col gap-1 text-left"
            >
              <span class="text-xs font-bold">{pad(i + 1)}</span>
              <img
                src={item.thumb}
                alt=""
                width={item.width}
                height={item.height}
                loading="lazy"
                decoding="async"
                draggable="false"
                class="block max-h-[calc(100%-20px)] w-auto flex-1 transition-opacity duration-500 group-aria-[current=false]:opacity-40 group-hover:opacity-100"
              />
            </button>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .no-scrollbar {
    scrollbar-width: none;
  }
  .no-scrollbar::-webkit-scrollbar {
    display: none;
  }
  /* Senza JS si vede la prima foto e il primo titolo; con JS ogni variante gestisce le altre. */
  [data-gallery-slide]:not([data-active]),
  [data-gallery-title]:not([data-active]) {
    visibility: hidden;
  }
</style>
