---
import RichText from './RichText.astro';
import type { Home } from '../../content/home';

interface Props {
  home: Home;
}
const { linkColumns, manifesto, projects } = Astro.props.home;
// Ritmo della griglia: 2 progetti da 6 colonne, poi 3 da 4, e si ripete
const colClass = (i: number) => (i % 5 < 2 ? 'col-span-12 lg:col-span-6' : 'col-span-12 lg:col-span-4');
// Le tre colonne sotto l'hero: la prima allineata a sinistra dalla seconda colonna, le altre a destra
const columnClass = (i: number) =>
  i === 0
    ? 'col-span-8 space-y-2 lg:col-span-2 lg:col-start-2 lg:space-y-5'
    : 'col-span-8 space-y-2 text-right lg:col-span-2 lg:space-y-5';
---

<!-- Link: info / AI Journal / letture -->
<section class="space-top-big">
  <div class="container-site grid-8">
    {linkColumns.map((col, i) => (
      <div class={columnClass(i)}>
        <h2 data-reveal="text" class="h5">
          {col.title}
        </h2>
        {col.items.some((item) => item.href) ? (
          col.items.map((item) => (
            <div data-reveal="text">
              {item.href ? (
                <a href={item.href} class="block text-sm">
                  {item.label}
                </a>
              ) : (
                <span class="block text-sm">{item.label}</span>
              )}
            </div>
          ))
        ) : (
          <p data-reveal="text" class="text-sm">
            {col.items.map((item, j) => (
              <Fragment>
                {j > 0 && <br />}
                {item.label}
              </Fragment>
            ))}
          </p>
        )}
      </div>
    ))}
  </div>
</section>

<!-- Manifesto -->
<section class="space-top-big">
  <div class="container-site grid-8">
    <div class="col-span-8 space-y-4 lg:col-span-6 lg:col-start-2">
      <div class="space-y-3">
        <p data-reveal="text" class="h5">
          {manifesto.kicker}
        </p>
        <div class="h3">
          <RichText value={manifesto.body} blockAttrs={(i) => ({ id: `manifesto-${i + 1}`, 'data-reveal': 'text' })} />
        </div>
      </div>
      <div class="flex flex-wrap items-center lg:gap-2">
        <p data-reveal="text" class="h5">
          {manifesto.alsoTitle}
        </p>
        <p data-reveal="text" class="text-[14px] leading-none lg:text-[15px]">
          {manifesto.alsoText}
        </p>
      </div>
    </div>
  </div>
</section>

<!-- Progetti -->
<section id="progetti" class="space-top-big">
  <div class="container-site">
    <ul class="grid-12 gap-y-5 lg:gap-y-20">
      {projects.map((p, i) => (
        <li class:list={[colClass(i), 'h-fit']}>
          <a href="#" class="group block w-full space-y-2 lg:space-y-4">
            <div data-reveal="image">
              <img {...p.image} loading="lazy" decoding="async" class="block h-auto w-full" />
            </div>
            <div>
              <p data-reveal="text" class="text-sm">
                {p.year}
              </p>
              <h3 data-reveal="text" class="h5">
                {p.title}
              </h3>
            </div>
          </a>
        </li>
      ))}
    </ul>
  </div>
</section>
