---
import Ampersand from './Ampersand.astro';
---
<section class="space-top-big" data-hero>
  <div class="container-site space-y-6 lg:space-y-8">
    <h1 class="sr-only">Andrea Ruggeri — Design-driven entrepreneur who generally crafts W** products &amp; digital experiences.</h1>
    <div aria-hidden="true">
      <div data-hero-row class="flex items-start gap-2">
        <div class="hero-line h2 overflow-hidden"><span class="block">Andrea Ruggeri</span></div>
        <div class="hero-info flex flex-col text-xs leading-none lg:mt-1 lg:text-sm lg:leading-none">
          <span>12 may</span><span>1992</span>
        </div>
      </div>
      <div data-hero-row class="flex items-start gap-2 lg:pl-16">
        <div class="hero-info hidden flex-col text-right text-sm leading-none lg:mt-1 lg:flex">
          <span>Italian</span><span>Left handed</span>
        </div>
        <div class="hero-line h2 overflow-hidden"><span class="block">Design-driven entrepreneur</span></div>
      </div>
      <div data-hero-row class="flex items-start gap-2">
        <div class="hero-line h2 overflow-hidden"><span class="block">Who generally crafts</span></div>
        <div class="hero-info hidden flex-col text-sm leading-none lg:mt-1 lg:flex">
          <span>Based on</span><span>weather</span>
        </div>
      </div>
      <div data-hero-row class="flex flex-wrap items-start lg:items-center lg:gap-2">
        <div class="hero-line h2 flex w-fit items-center gap-1 overflow-hidden">
          <span class="block">W** products</span>
          <Ampersand class="hero-info inline-flex w-full max-w-[28px] -translate-y-1 lg:hidden" />
        </div>
        <Ampersand class="hero-info hidden w-full translate-y-1 lg:inline-flex lg:max-w-[74px]" />
        <div class="hero-line h2 w-fit overflow-hidden"><span class="block">digital Experiences.</span></div>
      </div>
    </div>
    <p class="hero-sub overflow-hidden text-sm">
      <span class="block">Combining creativity with strategic thinking to shape <b>purposeful digital products</b>.</span>
    </p>
  </div>
</section>
