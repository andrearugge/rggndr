---
import type { LabVariant } from '../../lib/lab';

interface Props {
  variants: LabVariant[];
  defaultId?: string;
}
const { variants, defaultId = variants[0]?.id } = Astro.props;
---
<nav
  class="lab-switcher fixed bottom-4 left-1/2 -translate-x-1/2 z-50 flex gap-1 rounded-full bg-primary p-1 text-[12px] leading-none font-bold text-cream shadow-[0_8px_24px_rgb(137_141_127/0.35)]"
  data-default={defaultId}
  aria-label="Varianti"
>
  {variants.map((v) => (
    <button type="button" data-variant={v.id} aria-pressed="false" class="rounded-full px-3 py-2 transition-colors aria-pressed:bg-cream aria-pressed:text-primary">
      {v.label}
    </button>
  ))}
</nav>

<script>
  import { getVariant } from '../../lib/lab';

  const nav = document.querySelector<HTMLElement>('.lab-switcher');
  if (nav) {
    const buttons = [...nav.querySelectorAll<HTMLButtonElement>('button[data-variant]')];
    const ids = buttons.map((b) => b.dataset.variant!);
    const setPressed = (id: string) =>
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.variant === id)));

    setPressed(getVariant(nav.dataset.default!, ids));

    buttons.forEach((b) =>
      b.addEventListener('click', () => {
        const id = b.dataset.variant!;
        const url = new URL(window.location.href);
        url.searchParams.set('v', id);
        history.replaceState(null, '', url);
        setPressed(id);
        window.dispatchEvent(new CustomEvent('lab:variant', { detail: id }));
      }),
    );
  }
</script>
