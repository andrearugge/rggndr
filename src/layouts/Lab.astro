---
import Base from './Base.astro';
import VariantSwitcher from '../components/lab/VariantSwitcher.astro';
import type { LabVariant } from '../lib/lab';

interface Props {
  title: string;
  variants?: LabVariant[];
  defaultVariant?: string;
  /** false quando la pagina usa già header/footer del sito */
  chrome?: boolean;
}
const { title, variants, defaultVariant, chrome = true } = Astro.props;
---
<Base title={`Lab — ${title}`} noindex>
  {chrome && (
    <header class="container-site fixed inset-x-0 top-0 z-40 flex justify-between py-6 text-[14px] leading-none font-bold">
      <a href="/lab/">← Lab</a>
      <span>{title}</span>
    </header>
  )}
  <slot />
  {variants && variants.length > 0 && <VariantSwitcher variants={variants} defaultId={defaultVariant} />}
</Base>
