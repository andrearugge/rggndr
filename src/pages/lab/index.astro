---
import Lab from '../../layouts/Lab.astro';

const experiments = [
  { href: '/lab/reveal', label: 'Reveal', note: 'Testi e immagini on scroll', ready: true },
  { href: '/lab/loader', label: 'Loader', note: 'Intro alla prima visita', ready: true },
  { href: '/lab/monogram', label: 'Monogram', note: 'Cinque concept da nome a RGGNDR', ready: true },
  { href: '/lab/loader-timing', label: 'Timing', note: 'Dieci ritmi del monogram, in loop', ready: true },
  { href: '/lab/gallery', label: 'Gallery', note: 'Motion della gallery', ready: true },
  { href: '/lab/card', label: 'Card', note: 'Card del footer interattiva', ready: true },
];
---
<Lab title="Index">
  <main class="container-site min-h-dvh pt-24 pb-10">
    <ol class="divide-y divide-primary/20 border-y border-primary/20">
      {experiments.map((e, i) => (
        <li class="flex items-baseline gap-4 py-4">
          <span class="h6">{String(i + 1).padStart(2, '0')}</span>
          {e.ready
            ? <a href={e.href} class="h2 transition-opacity hover:opacity-60">{e.label}</a>
            : <span class="h2 opacity-25">{e.label}</span>}
          <span class="ml-auto text-sm">{e.ready ? e.note : 'Presto'}</span>
        </li>
      ))}
    </ol>
  </main>
</Lab>
