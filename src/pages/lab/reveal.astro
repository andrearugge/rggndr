---
import Lab from '../../layouts/Lab.astro';
import Header from '../../components/site/Header.astro';
import Hero from '../../components/site/Hero.astro';
import Footer from '../../components/site/Footer.astro';
import HomeSections from '../../components/site/HomeSections.astro';
---
<Lab title="Reveal" chrome={false}>
  <Header current="/" />

  <main class="space-bottom-big overflow-x-clip">
    <Hero />

    <HomeSections />
  </main>

  <Footer />
</Lab>

<script>
  import { initReveals } from '../../lib/reveal';
  import { playHeroIntro } from '../../lib/hero-intro';
  import { initSmoothScroll, gsap, prefersReducedMotion } from '../../lib/motion';

  const hero = document.querySelector<HTMLElement>('[data-hero]');
  initSmoothScroll();

  if (hero) playHeroIntro(hero);

  // Simbolo del footer che ruota con lo scroll, come sul sito attuale
  const rotator = document.querySelector('[data-footer-rotator]');
  if (rotator && !prefersReducedMotion()) {
    gsap.to(rotator, {
      rotate: 360,
      ease: 'none',
      scrollTrigger: { trigger: 'footer', start: 'top bottom', end: 'bottom top', scrub: true },
    });
  }

  initReveals(document.querySelector<HTMLElement>('main')!);
</script>
