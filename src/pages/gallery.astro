---
import Base from '../layouts/Base.astro';
import Header from '../components/site/Header.astro';
import Gallery from '../components/site/Gallery.astro';
import { getGallery } from '../content/gallery';

const items = await getGallery();
---

<Base title="Gallery – Andrea Ruggeri">
  <Header current="/gallery/" />
  <main>
    <h1 class="sr-only">Gallery</h1>
    <Gallery items={items} />
  </main>
</Base>

<script>
  import { initGallery } from '../lib/gallery';

  initGallery(document.querySelector<HTMLElement>('[data-gallery]')!);
</script>
