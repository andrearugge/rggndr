{
  "name": "rggndr",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.23.4"
  },
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "test": "playwright test",
    "typecheck": "astro check",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run typecheck && npm run format:check && npm run build && node scripts/check-dist.mjs && npm run test:unit && npm test",
    "studio": "npm --prefix studio run dev",
    "test:unit": "playwright test -c playwright.unit.config.ts",
    "typegen": "npm --prefix studio run typegen"
  },
  "dependencies": {
    "@sanity/client": "^8.16.0",
    "@tailwindcss/vite": "^4.3.5",
    "astro": "^7.4.12",
    "groq": "^6.23.0",
    "groq-js": "^2.0.1",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "tailwindcss": "^4.3.5"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@playwright/test": "^1.65.1",
    "@types/node": "^24.19.2",
    "prettier": "^3.10.1",
    "prettier-plugin-astro": "^1.1.2",
    "typescript": "^6.0.3"
  }
}
